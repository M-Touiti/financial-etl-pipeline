DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/etl_db
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=etl-pipeline-group
KAFKA_TOPIC_MARKET_DATA=market-data-events
PIPELINE_BATCH_SIZE=1000
SCHEDULER_ENABLED=true
FILE_SCAN_INTERVAL_MINUTES=5
FILE_INPUT_DIR=./data/input
FILE_ARCHIVE_DIR=./data/archive
FILE_ERROR_DIR=./data/errors
DEBUG=false
